
# --------------------------------------------------
# Lambda deployment packages
# Generated by esbuild before Terraform runs.
# --------------------------------------------------

data "archive_file" "l2_package" {
  type        = "zip"
  source_file = "${path.module}/../build/lambda/l2_sqsListner.js"
  output_path = "${path.module}/../build/lambda/l2_sqsListner.zip"
}

data "archive_file" "l3_package" {
  type        = "zip"
  source_file = "${path.module}/../build/lambda/l3_validator.js"
  output_path = "${path.module}/../build/lambda/l3_validator.zip"
}

data "archive_file" "l4_package" {
  type        = "zip"
  source_dir  = "${path.module}/../build/lambda/l4-package"
  output_path = "${path.module}/../build/lambda/l4_processor.zip"
}

data "archive_file" "l5_package" {
  type        = "zip"
  source_file = "${path.module}/../build/lambda/l5_finalizer.js"
  output_path = "${path.module}/../build/lambda/l5_finalizer.zip"
}

# --------------------------------------------------
# L2: SQS Listener
# --------------------------------------------------

resource "aws_lambda_function" "l2_sqs_listener" {
  function_name = "l2_sqs_listener"
  description   = "Consumes S3 upload notifications from SQS and starts the image processing workflow"

  role             = aws_iam_role.lambda_l2_role.arn
  runtime          = "nodejs22.x"
  handler          = "l2_sqsListner.handler"
  filename         = data.archive_file.l2_package.output_path
  source_code_hash = data.archive_file.l2_package.output_base64sha256

  timeout     = 60
  memory_size = 256

  environment {
    variables = {
      STATE_MACHINE_ARN = aws_sfn_state_machine.image_pipeline.arn
    }
  }

  depends_on = [
    aws_iam_role_policy_attachment.lambda_l2_basic,
    aws_iam_role_policy.l2_permissions
  ]

  tags = {
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}

# --------------------------------------------------
# L3: Image Validator
# --------------------------------------------------

resource "aws_lambda_function" "l3_validator" {
  function_name = "l3_validator"
  description   = "Validates uploaded image metadata and content type"

  role             = aws_iam_role.lambda_l3_role.arn
  runtime          = "nodejs22.x"
  handler          = "l3_validator.handler"
  filename         = data.archive_file.l3_package.output_path
  source_code_hash = data.archive_file.l3_package.output_base64sha256

  timeout     = 30
  memory_size = 256

  depends_on = [
    aws_iam_role_policy_attachment.lambda_l3_basic,
    aws_iam_role_policy.l3_permissions
  ]

  tags = {
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}

# --------------------------------------------------
# L4: Image Processor
# --------------------------------------------------
resource "aws_lambda_function" "l4_processor" {
  function_name = "l4_processor"
  description   = "Processes validated images and generates WebP thumbnails and metadata"

  role             = aws_iam_role.lambda_l4_role.arn
  runtime          = "nodejs22.x"
  handler          = "l4_processor.handler"
  filename         = data.archive_file.l4_package.output_path
  source_code_hash = data.archive_file.l4_package.output_base64sha256

  architectures = ["x86_64"]

  timeout     = 60
  memory_size = 512

  depends_on = [
    aws_iam_role_policy_attachment.lambda_l4_basic,
    aws_iam_role_policy.l4_permissions
  ]

  tags = {
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}
# --------------------------------------------------
# L5: Finalizer
# --------------------------------------------------
resource "aws_lambda_function" "l5_finalizer" {
  function_name = "l5_finalizer"
  description   = "Publishes image processing completion events"

  role             = aws_iam_role.lambda_l5_role.arn
  runtime          = "nodejs22.x"
  handler          = "l5_finalizer.handler"
  filename         = data.archive_file.l5_package.output_path
  source_code_hash = data.archive_file.l5_package.output_base64sha256

  timeout     = 30
  memory_size = 256

  environment {
    variables = {
      COMPLETION_QUEUE_URL = aws_sqs_queue.completion_queue.id
    }
  }

  depends_on = [
    aws_iam_role_policy_attachment.lambda_l5_basic,
    aws_iam_role_policy.l5_permissions,
    aws_iam_role_policy.l5_s3_permissions
  ]

  tags = {
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}
# --------------------------------------------------
# SQS -> L2 event source mapping
# --------------------------------------------------
resource "aws_lambda_event_source_mapping" "sqs_trigger_l2" {
  event_source_arn = aws_sqs_queue.upload_queue.arn
  function_name    = aws_lambda_function.l2_sqs_listener.arn

  enabled    = true
  batch_size = 1

  depends_on = [
    aws_iam_role_policy.l2_permissions
  ]
}
